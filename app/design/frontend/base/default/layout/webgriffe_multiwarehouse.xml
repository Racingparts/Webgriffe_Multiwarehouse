<?xml version="1.0"?>
<layout version="0.1.0">
    <catalog_product_view>
        <reference name="head">
            <action method="addJs" ifconfig="catalog/wgmulti_delivery/enabled"><script>webgriffe/multiwarehouse/delivery.js</script></action>
        </reference>
        <reference name="product.info.extrahint">
            <block type="wgmulti/catalog_product_delivery" name="wgmulti.delivery" template="webgriffe/multiwarehouse/delivery.phtml"/>
        </reference>
    </catalog_product_view>
	<PRODUCT_TYPE_simple>
		<reference name="head">
			<action method="addItem"><type>skin_css</type><name>css/multiwarehouse.css</name></action>
		</reference>		
		<reference name="product.info.simple">
			<action method="setTemplate">
				<template>webgriffe/multiwarehouse/availability/default.phtml</template>
			</action>
		</reference>
	</PRODUCT_TYPE_simple>
</layout>
